<script setup lang="ts">
import { ref, computed, onMounted, onUnmounted, watch } from "vue";
import "maplibre-gl/dist/maplibre-gl.css";
import { storeToRefs } from "pinia";
import { useMapObjectStore } from "@/store/useMapObjectStore";
import { useL7 } from "@/composables/useL7";
import { TilesSwitcher } from "@/components/TilesSwitcher";
import MapOptions from "./MapOptions.vue";
import PlusCursor from "@/assets/plus-cursor.svg";
import GrabCursor from "@/assets/grab-cursor.svg";
import type { LngLatTuple } from "@/types";

// AntV L7 imports
import { Scene, PolygonLayer, LineLayer, PointLayer } from "@antv/l7";
import { MapLibre } from "@antv/l7-maps";

const mapObjectStore = useMapObjectStore();

const { Objects, DraftObject } = storeToRefs(mapObjectStore);

// L7 Scene
const l7Scene = ref<Scene | null>(null);
const mapInstance = ref<any>(null);

// Курсоры
const plusCursor = computed(() => `url("${PlusCursor}") 16 16, auto`);
const grabCursor = computed(() => `url("${GrabCursor}") 16 16, auto`);

// Состояние для курсора
const isDragging = ref(false);

// L7 composable
const {
  handleMapClick,
  finalizeObject,
  cancelObject,
  undo,
  redo,
  canUndo,
  canRedo,
} = useL7();

// Обработка клика по карте
const onMapClick = (e: any) => {
  const lngLat: LngLatTuple = [e.lngLat.lng, e.lngLat.lat];
  console.log("[Map] Клик:", lngLat);
  handleMapClick(lngLat);
};

// Выделение объекта при клике
const selectObject = (id: string) => {
  console.log("[Map] Select object:", id);
  mapObjectStore.ClickedObjId = id;
};

// Создание слоёв L7
const createLayers = () => {
  console.log("[Map] createLayers вызван");
  console.log("[Map] l7Scene.value:", l7Scene.value);
  console.log("[Map] Objects.value.size:", Objects.value?.size);
  console.log("[Map] DraftObject:", DraftObject.value);

  if (!l7Scene.value) {
    console.error("[Map] l7Scene.value отсутствует");
    return;
  }

  // Очищаем старые слои
  const layers = l7Scene.value.getLayers();
  console.log("[Map] Слоёв до очистки:", layers.length);
  layers.forEach((layer: any) => {
    l7Scene.value?.removeLayer(layer);
  });

  // Явно читаем Objects.value для реактивности
  const objectsArray = Array.from(Objects.value?.values() ?? []);
  console.log("[Map] Создаём слои для существующих объектов:", objectsArray.length);

  // ========================================================================
  // СЛОИ ДЛЯ СУЩЕСТВУЮЩИХ ОБЪЕКТОВ
  // ========================================================================

  // Polygon слой (заливка)
  const polygonFillData = objectsArray
    .filter((obj) => obj.type === "Polygon" && obj.style.filled !== false)
    .map((obj) => {
      // Явно читаем свойства для реактивности
      const fillColor = obj.style.fillColor ?? [0, 128, 255, 128];
      const fillOpacity = obj.style.fillOpacity ?? 0.3;
      
      // Конвертируем координаты из Proxy в чистый массив
      const coordinates = obj.coordinates.map(
        (coord: LngLatTuple) => [coord[0]!, coord[1]!] as [number, number]
      );
      
      return {
        id: obj.id,
        coordinates,
        fillColor,
        fillOpacity,
      };
    });

  console.log("[Map] Polygon fill данные:", polygonFillData.length, "объектов");
  if (polygonFillData.length > 0) {
    console.log("[Map] Первый polygon:", polygonFillData[0]);
  }

  if (polygonFillData.length > 0) {
    const polygonFillLayer = new PolygonLayer({
      autoFit: false,
    })
      .source({
        type: "json",
        data: {
          type: "FeatureCollection",
          features: polygonFillData.map((obj) => ({
            type: "Feature",
            properties: {
              id: obj.id,
              fillColor: obj.fillColor,
              fillOpacity: obj.fillOpacity,
            },
            geometry: {
              type: "Polygon",
              coordinates: [obj.coordinates],
            },
          })),
        },
      })
      .shape("fill")
      .color("fillColor")
      .active(true)
      .style({
        opacity: 1,
      });

    // Добавляем обработчик клика на слой
    polygonFillLayer.on("click", (e: any) => {
      console.log("[Map] Polygon layer click:", e);
      if (e.feature?.properties?.id) {
        selectObject(e.feature.properties.id);
      }
    });

    l7Scene.value.addLayer(polygonFillLayer);
    console.log("[Map] Polygon fill слой добавлен");
  }

  // Polygon/Polyline слой (контур)
  const lineData = objectsArray
    .filter((obj) => obj.type === "Polygon" || obj.type === "Polyline")
    .map((obj) => {
      const strokeColor = obj.style.strokeColor ?? [0, 128, 255, 255];
      const strokeWidth = obj.style.strokeWidth ?? 3;
      
      // Конвертируем координаты из Proxy
      const coordinates = obj.coordinates.map(
        (coord: LngLatTuple) => [coord[0]!, coord[1]!] as [number, number]
      );
      
      return {
        id: obj.id,
        coordinates,
        strokeColor,
        strokeWidth,
      };
    });

  console.log("[Map] Line данные:", lineData.length, "объектов");
  if (lineData.length > 0) {
    console.log("[Map] Первая линия:", lineData[0]);
  }

  if (lineData.length > 0) {
    const lineLayer = new LineLayer({
      autoFit: false,
    })
      .source({
        type: "json",
        data: {
          type: "FeatureCollection",
          features: lineData.map((obj) => ({
            type: "Feature",
            properties: {
              id: obj.id,
              strokeColor: obj.strokeColor,
              strokeWidth: obj.strokeWidth,
            },
            geometry: {
              type: "LineString",
              coordinates: obj.coordinates,
            },
          })),
        },
      })
      .shape("line")
      .size("strokeWidth")
      .color("strokeColor")
      .active(true)
      .style({
        lineType: "solid",
      });

    // Добавляем обработчик клика на слой
    lineLayer.on("click", (e: any) => {
      console.log("[Map] Line layer click:", e);
      if (e.feature?.properties?.id) {
        selectObject(e.feature.properties.id);
      }
    });

    l7Scene.value.addLayer(lineLayer);
    console.log("[Map] Line слой добавлен");
  }

  // Point слой (для CircleMarker)
  const pointData = objectsArray
    .filter((obj) => obj.type === "CircleMarker")
    .map((obj) => {
      const fillColor = obj.style.fillColor ?? [0, 255, 0, 255];
      
      // Конвертируем координаты из Proxy
      const coordinates = obj.coordinates[0] 
        ? [obj.coordinates[0][0]!, obj.coordinates[0][1]!] as [number, number]
        : [0, 0] as [number, number];
      
      return {
        id: obj.id,
        coordinates,
        fillColor,
        radius: 15,
      };
    });

  console.log("[Map] Point данные:", pointData.length, "объектов");
  if (pointData.length > 0) {
    console.log("[Map] Первая точка:", pointData[0]);
  }

  if (pointData.length > 0) {
    const pointLayer = new PointLayer({
      autoFit: false,
    })
      .source({
        type: "json",
        data: {
          type: "FeatureCollection",
          features: pointData.map((obj) => ({
            type: "Feature",
            properties: {
              id: obj.id,
              fillColor: obj.fillColor,
              radius: obj.radius,
            },
            geometry: {
              type: "Point",
              coordinates: obj.coordinates,
            },
          })),
        },
      })
      .shape("circle")
      .size("radius")
      .color("fillColor")
      .active(true)
      .style({
        opacity: 1,
      });

    // Добавляем обработчик клика на слой
    pointLayer.on("click", (e: any) => {
      console.log("[Map] Point layer click:", e);
      if (e.feature?.properties?.id) {
        selectObject(e.feature.properties.id);
      }
    });

    l7Scene.value.addLayer(pointLayer);
    console.log("[Map] Point слой добавлен");
  }

  // ========================================================================
  // СЛОЙ ДЛЯ DRAFT ОБЪЕКТА (в процессе создания)
  // ========================================================================
  
  if (DraftObject.value && DraftObject.value.coordinates.length > 0) {
    console.log(
      "[Map] Draft объект:",
      DraftObject.value.type,
      DraftObject.value.coordinates.length,
      "точек",
    );

    const draft = DraftObject.value;
    
    // Конвертируем координаты из Proxy
    const coordinates = draft.coordinates.map(
      (coord: LngLatTuple) => [coord[0]!, coord[1]!] as [number, number]
    );

    // Жёлтый цвет для draft
    const draftColor = [255, 255, 0, 255] as [number, number, number, number];

    // Для CircleMarker показываем даже с 1 точкой
    if (draft.type === "CircleMarker" && coordinates.length > 0) {
      const draftPointLayer = new PointLayer({
        autoFit: false,
      })
        .source({
          type: "json",
          data: {
            type: "FeatureCollection",
            features: [
              {
                type: "Feature",
                properties: {
                  id: "draft",
                  fillColor: draftColor,
                  radius: 15,
                },
                geometry: {
                  type: "Point",
                  coordinates: coordinates[0]!,
                },
              },
            ],
          },
        })
        .shape("circle")
        .size("radius")
        .color("fillColor")
        .active(false)
        .style({
          opacity: 1,
        });

      l7Scene.value.addLayer(draftPointLayer);
      console.log("[Map] Draft Point слой добавлен");
    } 
    // Для Polygon/Polyline нужно минимум 2 точки
    else if (coordinates.length >= 2) {
      // Линия контура для draft
      const draftLineLayer = new LineLayer({
        autoFit: false,
      })
        .source({
          type: "json",
          data: {
            type: "FeatureCollection",
            features: [
              {
                type: "Feature",
                properties: {
                  id: "draft",
                  strokeColor: draftColor,
                  strokeWidth: 3,
                },
                geometry: {
                  type: "LineString",
                  coordinates,
                },
              },
            ],
          },
        })
        .shape("line")
        .size("strokeWidth")
        .color("strokeColor")
        .active(false)
        .style({
          lineType: "solid",
        });

      l7Scene.value.addLayer(draftLineLayer);
      console.log("[Map] Draft Line слой добавлен");

      // Для полигона добавляем заливку если >= 3 точек
      if (draft.type === "Polygon" && coordinates.length >= 3) {
        const draftFillLayer = new PolygonLayer({
          autoFit: false,
        })
          .source({
            type: "json",
            data: {
              type: "FeatureCollection",
              features: [
                {
                  type: "Feature",
                  properties: {
                    id: "draft",
                    fillColor: [255, 255, 0, 100] as [number, number, number, number],
                    fillOpacity: 0.3,
                  },
                  geometry: {
                    type: "Polygon",
                    coordinates: [coordinates],
                  },
                },
              ],
            },
          })
          .shape("fill")
          .color("fillColor")
          .active(false)
          .style({
            opacity: 1,
          });

        l7Scene.value.addLayer(draftFillLayer);
        console.log("[Map] Draft Polygon fill слой добавлен");
      }
    }
  }

  console.log("[Map] createLayers завершён");
  console.log("[Map] Всего слоёв:", l7Scene.value.getLayers().length);
};

// Инициализация карты
onMounted(async () => {
  console.log("[Map] onMounted - начинаем инициализацию");
  
  try {
    // Создаём L7 Scene с MapLibre adapter (официальный пример)
    const scene = new Scene({
      id: "map",
      map: new MapLibre({
        style: "https://demotiles.maplibre.org/style.json",
        center: [103.888249, 52.544358],
        zoom: 14,
        rotation: 0,
        pitch: 0,
      }),
    });

    // Сохраняем сцену
    l7Scene.value = scene;
    console.log("[Map] L7 Scene создана");

    // Экспортируем сцену в window для отладки
    (window as any).__L7_SCENE = scene;

    // Ждём загрузки L7 сцены
    scene.on("loaded", () => {
      console.log("[Map] L7 Scene загружена");
      console.log("[Map] L7 Scene object:", scene);
      console.log("[Map] Map adapter:", (scene as any).map);

      // Получаем MapLibre instance из L7
      mapInstance.value = (scene as any).map?.map;
      console.log("[Map] MapLibre instance из L7:", mapInstance.value);

      // Добавляем обработчик клика на MapLibre карту
      if (mapInstance.value) {
        mapInstance.value.on("click", onMapClick);
        console.log("[Map] MapLibre click обработчик добавлен");
      }

      // Добавляем обработчик клика на L7 сцену
      scene.on("click", (e: any) => {
        console.log("[Map] L7 click event:", e);
        if (e.lngLat) {
          const lngLat: LngLatTuple = [e.lngLat.lng, e.lngLat.lat];
          console.log("[Map] Клик через L7:", lngLat);
          handleMapClick(lngLat);
        }
      });
      console.log("[Map] L7 click обработчик добавлен");

      // Создаём тестовый слой для проверки рендеринга
      console.log("[Map] Создаём тестовый PointLayer...");
      const testPointLayer = new PointLayer({
        autoFit: false,
      })
        .source({
          type: "json",
          data: {
            type: "FeatureCollection",
            features: [
              {
                type: "Feature",
                properties: {
                  id: "test-point",
                  color: [255, 0, 0, 255],
                },
                geometry: {
                  type: "Point",
                  coordinates: [103.888249, 52.544358],
                },
              },
            ],
          },
        })
        .shape("circle")
        .size(20)
        .color("color")
        .active(true)
        .style({
          opacity: 1,
        });

      scene.addLayer(testPointLayer);
      console.log("[Map] Тестовый PointLayer добавлен");
      console.log("[Map] Всего слоёв:", scene.getLayers().length);

      // Проверяем canvas через 1 секунду
      setTimeout(() => {
        const l7Canvas = document.querySelector('.l7-scene canvas');
        console.log("[Map] L7 canvas:", l7Canvas);
        if (l7Canvas) {
          const gl = l7Canvas.getContext('webgl');
          console.log("[Map] L7 canvas WebGL context:", gl ? "OK" : "NULL");
          console.log("[Map] L7 canvas размеры:", l7Canvas.width, "x", l7Canvas.height);
        }
        
        // Проверяем все canvas
        const allCanvas = document.querySelectorAll('canvas');
        console.log("[Map] Все canvas:", allCanvas.length);
        allCanvas.forEach((c, i) => {
          console.log(`[Map] Canvas ${i}:`, c.className || 'без класса', c.width, "x", c.height);
        });
      }, 1000);

      createLayers();
    });
  } catch (error) {
    console.error("[Map] Ошибка инициализации:", error);
  }
});

// Watch для реактивности
watch(
  () => Objects.value,
  () => {
    console.log("[Map] Objects изменился, перерисовка:", Objects.value.size);
    if (l7Scene.value) {
      createLayers();
    }
  },
  { deep: true },
);

watch(
  () => DraftObject.value,
  () => {
    console.log(
      "[Map] Draft объект изменился:",
      DraftObject.value?.coordinates.length ?? 0,
      "точек",
    );
    if (l7Scene.value) {
      createLayers();
    }
  },
  { deep: true },
);

// Очистка при размонтировании
onUnmounted(() => {
  console.log("[Map] onUnmounted - уничтожаем сцену");
  if (l7Scene.value) {
    l7Scene.value.destroy();
    l7Scene.value = null;
  }
});
</script>

<template>
  <MapOptions
    :cancel-changes="cancelObject"
    :submit-changes="finalizeObject"
    :prev-action="undo"
    :next-action="redo"
    :can-undo="canUndo"
    :can-redo="canRedo"
  />
  <TilesSwitcher />
  <div class="flex-1 h-screen overflow-scroll">
    <div
      id="map"
      class="relative"
      :style="{
        cursor: isDragging ? grabCursor : plusCursor,
      }"
    ></div>
  </div>
</template>

<style scoped>
:deep(#map) {
  height: 100vh;
  width: 100vw;
  outline: none;
  user-select: none;
  position: relative;
}

/* Все L7 элементы - pointer-events: none чтобы клики проходили к карте */
:deep(.l7-canvas-container),
:deep(.l7-scene),
:deep(.l7-marker-container),
:deep(.l7-tooltip),
:deep(.l7-popup) {
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
  z-index: 10 !important;
  pointer-events: none !important;
}

/* Canvas внутри L7 */
:deep(.l7-canvas-container canvas) {
  pointer-events: none !important;
}

/* MapLibre canvas */
:deep(.maplibregl-canvas) {
  cursor: v-bind(plusCursor) !important;
}

:deep(.maplibregl-canvas:active) {
  cursor: v-bind(grabCursor) !important;
}
</style>
